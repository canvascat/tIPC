{
	"name": "tipc-electron",
	"version": "0.0.5",
	"description": "A typesafe IPC library for Electron",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./main": {
			"import": {
				"types": "./dist/main/index.d.mts",
				"default": "./dist/main/index.mjs"
			},
			"require": {
				"types": "./dist/main/index.d.cts",
				"default": "./dist/main/index.cjs"
			}
		},
		"./renderer": {
			"import": {
				"types": "./dist/renderer.d.mts",
				"default": "./dist/renderer.mjs"
			},
			"require": {
				"types": "./dist/renderer.d.cts",
				"default": "./dist/renderer.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"prepublishOnly": "pnpm build"
	},
	"keywords": [
		"typescript",
		"electron",
		"ipc",
		"trpc"
	],
	"author": {
		"name": "canvascat",
		"email": "canvascat@qq.com",
		"url": "https://github.com/canvascat"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/canvascat/tIPC"
	},
	"homepage": "https://github.com/canvascat/tIPC/tree/main/packages/electron-tipc",
	"bugs": "https://github.com/canvascat/tIPC/issues",
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"electron": "^45.2.3",
		"rxjs": "^7.8.2",
		"tsdown": "^0.23.7",
		"typescript": "~7.0.2"
	},
	"files": [
		"dist",
		"src"
	],
	"peerDependencies": {
		"electron": ">=37.2.0 <46",
		"rxjs": "^7.8.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
