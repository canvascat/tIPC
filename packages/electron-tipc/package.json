{
	"name": "tipc-electron",
	"version": "0.0.5",
	"description": "A typesafe IPC library for Electron",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./main": {
			"types": "./dist/main/index.d.mts",
			"import": "./dist/main/index.mjs",
			"require": "./dist/main/index.cjs"
		},
		"./renderer": {
			"types": "./dist/renderer.d.mts",
			"import": "./dist/renderer.mjs",
			"require": "./dist/renderer.cjs"
		}
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build"
	},
	"keywords": [
		"typescript",
		"electron",
		"ipc",
		"trpc"
	],
	"author": {
		"name": "canvascat",
		"email": "canvascat@qq.com",
		"url": "https://github.com/canvascat"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/canvascat/tIPC"
	},
	"homepage": "https://github.com/canvascat/tIPC/tree/main/packages/electron-tipc",
	"bugs": "https://github.com/canvascat/tIPC/issues",
	"license": "MIT",
	"devDependencies": {
		"electron": "^37.2.0",
		"rxjs": "^7.8.2",
		"typescript": "^5.0.0",
		"vite-plus": "catalog:"
	},
	"files": [
		"dist",
		"src"
	],
	"peerDependencies": {
		"electron": "^37.2.0",
		"rxjs": "^7.8.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
